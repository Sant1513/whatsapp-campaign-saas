# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (production)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Redis (BullMQ queue) ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Encryption (AES-256-GCM for Serri API keys at rest) ────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must decode to exactly 32 bytes
ENCRYPTION_KEY="your-base64-encoded-32-byte-key="

# ─── Serri send mode ─────────────────────────────────────────────────────────
# "dry-run" = build + validate payload, do NOT transmit (safe default)
# "live"    = actually call the Serri API
SERRI_MODE="dry-run"

# ─── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"
# For S3: STORAGE_DRIVER="s3", plus AWS_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# ─── Local no-install demo (PGlite + inline send) ───────────────────────────
# Set DEMO_DB=pglite to skip real Postgres (uses in-process WASM Postgres).
# Set DEMO_INLINE_SEND=1 to skip Redis/BullMQ (synchronous send in the request).
# Leave both unset / "off" / "" in production.
DEMO_DB="off"
DEMO_PGLITE_DIR="./.pgdata-lite"
DEMO_INLINE_SEND="0"
